---
import { DIRECT, SIMPLIFIED, naira, personById, type Debt } from '../lib/detty';

/*
 * "6 payments → 3", kept simple: the six payments without taab beside the
 * three that settle everyone. The example is real maths (see lib/detty.ts):
 * Gbayin was only passing money along, and David was in the middle.
 */
const slip = (d: Debt) => ({ from: personById(d.from), to: personById(d.to), amount: naira(d.amount) });
---

<section class="settle on-dark" id="settle" aria-labelledby="settle-title">
  <div class="inner">
    <header>
      <p class="eyebrow">Settle it · Detty December</p>
      <h2 id="settle-title"><span class="tabular">{DIRECT.length}</span> payments <span class="to">→ {SIMPLIFIED.length}</span></h2>
      <p class="lede">Six friends, four bills. taab works out the fewest payments that settle everyone.</p>
    </header>

    <div class="compare">
      <div class="column before">
        <p class="label">Without taab · {DIRECT.length} payments</p>
        <ul class="slips small">
          {
            DIRECT.map((d) => {
              const s = slip(d);
              return (
                <li>
                  <i style={`background:${s.from.colour}`} />
                  <span>
                    {s.from.name} → {s.to.name}
                  </span>
                  <b class="tabular">{s.amount}</b>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="column after">
        <p class="label">With taab · {SIMPLIFIED.length} payments</p>
        <ul class="slips">
          {
            SIMPLIFIED.map((d) => {
              const s = slip(d);
              return (
                <li>
                  <i style={`background:${s.from.colour}`} />
                  <span>
                    {s.from.name} → {s.to.name}
                  </span>
                  <b class="tabular">{s.amount}</b>
                  <em>Transfer now</em>
                </li>
              );
            })
          }
        </ul>
        <ul class="why">
          <li>Gbayin was just passing money along, so Ini and Femi pay you directly.</li>
          <li>David was in the middle, and what you and Macky owe each other cancels out.</li>
          <li>Same result. Everyone ends at ₦0.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Colours come from .on-dark in global.css. */
  .settle {
    padding-block: clamp(64px, 12vw, 120px);
    padding-inline: var(--gutter);
  }
  .inner {
    max-width: 1040px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 6vw, 56px);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 640px;
  }
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--turquoise);
  }
  h2 {
    font-size: clamp(2.4rem, 9vw, 4.5rem);
    font-weight: 700;
  }
  .to {
    color: var(--turquoise);
  }
  .lede {
    max-width: 44ch;
  }
  .compare {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 820px) {
    .compare {
      grid-template-columns: 1fr 1.15fr;
      gap: 48px;
      align-items: start;
    }
  }
  .column {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .label {
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }
  .after .label {
    color: var(--turquoise);
  }
  .slips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .slips li {
    display: grid;
    grid-template-columns: 10px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--on-dark);
    color: var(--charcoal);
  }
  .slips i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(var(--shadow) / 0.15);
  }
  .slips span {
    min-width: 0;
  }
  .slips b {
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .after .slips li {
    grid-template-columns: 10px 1fr auto auto;
  }
  .slips em {
    font-style: normal;
    font-weight: 600;
    font-size: 0.85rem;
    background: var(--turquoise);
    color: var(--charcoal);
    padding: 8px 12px;
    border-radius: 12px;
    white-space: nowrap;
  }
  /* The six "before" payments are quieter and denser. */
  .small li {
    padding: 10px 14px;
    background: var(--dark-raised);
    border: 1px solid var(--dark-border);
    color: var(--on-dark);
    font-size: 0.92rem;
  }
  .small b {
    font-size: 0.95rem;
  }
  @media (min-width: 520px) and (max-width: 819px) {
    .small {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
  .why {
    margin: 4px 0 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--on-dark-muted);
    font-size: 0.95rem;
  }
  @media (max-width: 400px) {
    .after .slips li {
      grid-template-columns: 10px 1fr auto;
    }
    .slips em {
      grid-column: 2 / -1;
      justify-self: start;
    }
  }
</style>
