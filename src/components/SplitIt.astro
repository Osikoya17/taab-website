---
import RedHornSplit from './RedHornSplit';
---

<section class="section split" aria-labelledby="split-title">
  <div class="section-inner split-layout">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Split it</p>
      <h2 id="split-title">Try it: dinner at Red Horn.</h2>
      <p class="lede">
        Tap who was there and choose how to split. These are taab’s real numbers, worked out the same way the app does it.
      </p>
      <p class="note">In the app you can also split by exact amounts or by percentages.</p>
    </div>
    <div class="demo" data-reveal style="--d: 150ms">
      <RedHornSplit client:visible />
    </div>
  </div>
</section>

<style>
  .split {
    background: var(--cream);
  }
  .note {
    color: var(--body);
    font-size: 0.95rem;
  }
  .demo {
    width: 100%;
    max-width: 440px;
    justify-self: center;
  }
  /* The island's markup (RedHornSplit.tsx) */
  .demo :global(.rh) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 30px 60px -40px rgb(var(--shadow) / 0.35);
  }
  .demo :global(.rh-head) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }
  .demo :global(.rh-taab) {
    font-weight: 600;
  }
  .demo :global(.rh-total) {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .demo :global(.rh-meta),
  .demo :global(.rh-label) {
    color: var(--body);
    font-size: 0.9rem;
  }
  .demo :global(button) {
    font: inherit;
    color: inherit;
    border: 0;
    background: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  /* How to split: a mint track; the chosen method is turquoise with charcoal text and a charcoal edge. */
  .demo :global(.rh-methods) {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 14px;
    background: var(--mint);
  }
  .demo :global(.rh-methods button) {
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--body);
  }
  .demo :global(.rh-methods button.on) {
    background: var(--turquoise);
    color: var(--charcoal);
    font-weight: 600;
    box-shadow: inset 0 0 0 1.5px var(--charcoal);
  }
  .demo :global(.rh-methods button:not(.on):active) {
    background: var(--mint-pressed);
    color: var(--charcoal);
  }

  /* Who was there: chosen people are turquoise with a charcoal edge. */
  .demo :global(.rh-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .demo :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    background: var(--surface);
    font-size: 0.9rem;
    color: var(--body);
  }
  .demo :global(.chip.on) {
    border-color: var(--charcoal);
    background: var(--turquoise);
    color: var(--charcoal);
    font-weight: 600;
  }
  .demo :global(.chip:not(.on):active) {
    background: var(--mint);
    color: var(--charcoal);
  }
  .demo :global(.chip.on:active) {
    background: var(--turquoise-pressed);
  }
  .demo :global(.dot) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 1px rgb(var(--shadow) / 0.15);
  }
  .demo :global(.dot.big) {
    width: 22px;
    height: 22px;
  }
  .demo :global(.rh-rows) {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .demo :global(.rh-rows li) {
    display: grid;
    grid-template-columns: 22px 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
    overflow: hidden;
  }
  .demo :global(.rh-rows b) {
    grid-column: 4;
    font-size: 1.05rem;
  }

  /* Share steppers: mint buttons; at 1 or 5 shares the button is marked unavailable (still focusable), with its own readable colours. */
  .demo :global(.stepper) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
  }
  .demo :global(.stepper button) {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--mint);
    color: var(--charcoal);
    font-size: 1rem;
  }
  .demo :global(.stepper button:not([aria-disabled="true"]):active) {
    background: var(--mint-pressed);
  }
  .demo :global(.stepper button[aria-disabled="true"]) {
    background: var(--disabled-bg);
    color: var(--disabled-text);
    cursor: not-allowed;
  }

  @media (hover: hover) {
    .demo :global(.rh-methods button:not(.on):hover) {
      background: var(--mint-hover);
      color: var(--charcoal);
    }
    .demo :global(.chip:not(.on):hover) {
      border-color: var(--border-strong);
      color: var(--charcoal);
    }
    .demo :global(.chip.on:hover) {
      background: var(--turquoise-hover);
    }
    .demo :global(.stepper button:not([aria-disabled="true"]):hover) {
      background: var(--mint-hover);
    }
  }

  .demo :global(.rh-check) {
    font-size: 0.9rem;
    color: var(--owed);
  }
  .demo :global(button:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
